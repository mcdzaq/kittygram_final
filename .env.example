# Copy to .env and replace both placeholders with separate random secrets.
# Keep .env outside Git and outside Docker build contexts.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

POSTGRES_DB=kittygram
POSTGRES_USER=kittygram_user
POSTGRES_PASSWORD=replace-with-a-random-database-password
DB_HOST=db
DB_PORT=5432

# Gateway listens only on loopback; an external HTTPS proxy can forward to it.
KITTYGRAM_PORT=9000
IMAGE_TAG=latest
